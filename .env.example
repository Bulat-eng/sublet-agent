# ─── Email delivery (Gmail SMTP — the notification channel) ───────────────────
# The agent emails you a digest whenever new matches appear. It sends through a
# Gmail account using an App Password (NOT your normal Gmail login password).
#
# Setup (5 min):
#   1. On the SENDER Gmail account, enable 2-Step Verification:
#        myaccount.google.com → Security → 2-Step Verification
#   2. Create an App Password:
#        myaccount.google.com/apppasswords  → name it "Sublet Agent" → Create
#   3. Copy the 16-character password (remove the spaces) into GMAIL_APP_PASSWORD.
#
# SENDER_EMAIL can be any Gmail (a burner is fine); TARGET_EMAIL is where the
# digest lands. They can be the same address.
SENDER_EMAIL=
GMAIL_APP_PASSWORD=
TARGET_EMAIL=REDACTED@example.com

# ─── Reddit ───────────────────────────────────────────────────────────────────
# No setup needed — we use public RSS feeds (no API key, no app creation).

# ─── Facebook (Phase 4, OPT-IN ONLY, local-only) ──────────────────────────────
# Set to "true" to enable. Requires Playwright + burner FB account.
# DO NOT enable in GitHub Actions — bans happen fast there.
ENABLE_FACEBOOK=false
FB_COOKIES_PATH=./fb_cookies.json
